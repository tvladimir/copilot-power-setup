{
  // ── Copilot Core ──
  "github.copilot.enable": {
    "*": true,
    "plaintext": true,
    "markdown": true,
    "yaml": true,
    "json": true,
    "jsonc": true
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.nextEditSuggestions.fixes": true,

  // ── Copilot Chat ──
  "github.copilot.chat.localeOverride": "en",
  "github.copilot.chat.useProjectTemplates": true,
  "github.copilot.chat.scopeSelection": true,
  "github.copilot.chat.codesearch.enabled": true,
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,

  // ── Agent mode ──
  "github.copilot.chat.agent.autoFix": true,
  "github.copilot.chat.agent.thinkingTool": true,
  "github.copilot.chat.summarizeAgentConversationHistory.enabled": true,
  "github.copilot.chat.organizationInstructions.enabled": true,
  "github.copilot.chat.organizationCustomAgents.enabled": true,
  "chat.agent.maxRequests": 50,

  // ── Permissions / autopilot ──
  // "chat.permissions.default" sets the default permission level for new chat sessions.
  // Options: "default" (Default Approvals — confirms each tool), "autoApprove" (auto-approve list below),
  //          "autopilot" (YOLO — only available if chat.autopilot.enabled is true).
  // Keep "default" until you've reviewed the auto-approve regex below for your env.
  "chat.permissions.default": "default",
  "chat.autopilot.enabled": true,

  // ── Auto-approval (granular; safe defaults — review before sharing across team) ──
  "chat.tools.global.autoApprove": false,
  "chat.tools.edits.autoApprove": false,
  "chat.tools.terminal.autoApprove": {
    "ls": true,
    "cat": true,
    "rg": true,
    "grep": true,
    "find": true,
    "echo": true,
    "git": true,
    "/^npm (run|test|install|ci|i)\\b/": true,
    "/^dotnet (build|test|restore|run)\\b/": true,
    "/^helm (lint|template|diff)\\b/": true,
    "rm": false,
    "rmdir": false,
    "del": false,
    "kill": false,
    "curl": false,
    "wget": false,
    "chmod": false,
    "chown": false
  },
  // Show terminal command output inline in chat (vs in the integrated terminal panel).
  "chat.tools.terminal.outputLocation": "chat",

  // ── Checkpoints (rollback safety) ──
  "chat.checkpoints.enabled": true,
  "chat.checkpoints.showFileChanges": true,

  // ── Cross-tool instruction files ──
  "chat.useAgentsMdFile": true,
  "chat.useClaudeMdFile": true,
  "chat.useNestedAgentsMdFiles": false,
  "chat.useCustomizationsInParentRepositories": true,
  // Auto-pull instruction files referenced via Markdown links from a loaded instruction.
  "chat.includeReferencedInstructions": true,

  // ── Prompt files ──
  // Recommend installed prompts (`/Foo`) when starting a new chat session.
  "chat.promptFilesRecommendations": true,

  // ── Agent Skills (stable since VS Code Jan 2026) ──
  // Skills live in `.github/skills/<name>/SKILL.md` (workspace) or `~/.copilot/skills/` (user).
  // Auto-discovered by the model from name+description; user can also invoke via /skillname.
  "chat.useAgentSkills": true,
  "chat.agentSkillsLocations": {
    ".github/skills": true
  },

  // ── Agent Hooks ──
  // Hooks live in `.github/hooks/*.json`. 8 lifecycle events: SessionStart, UserPromptSubmit,
  // PreToolUse, PostToolUse, PreCompact, SubagentStart, SubagentStop, Stop.
  "chat.hookFilesLocations": {
    ".github/hooks": true
  },

  // ── MCP ──
  "chat.mcp.discovery.enabled": true,
  "chat.mcp.autoStart": true,

  // ── Test / code-gen helpers ──
  "github.copilot.chat.generateTests.codeLens": true,
  "github.copilot.chat.startDebugging.enabled": true,
  "github.copilot.chat.edits.suggestRelatedFilesFromGitHistory": true,
  "github.copilot.chat.terminalChatLocation": "chatView",

  // ── Commit message + PR description generation ──
  // Each entry is either an inline rule ({"text": "..."}) or a file reference ({"file": "..."}).
  // Files resolve relative to workspace root.
  "github.copilot.chat.commitMessageGeneration.instructions": [
    { "text": "Use Conventional Commits: type(scope): subject. Types: feat, fix, refactor, docs, test, chore, perf, ci, build." },
    { "text": "Subject line max 72 chars, imperative mood, no trailing period." },
    { "text": "Body explains the WHY, not the WHAT. Wrap at 100 chars. Skip the body for trivial changes." },
    { "text": "Reference issue keys (e.g. JIRA-1234) on a separate trailing line when present." }
  ],
  "github.copilot.chat.pullRequestDescriptionGeneration.instructions": [
    { "text": "Title in Conventional Commits style." },
    { "text": "Body sections: ## Summary (2-3 bullets), ## Changes (file groups + intent), ## Test plan (checklist)." },
    { "text": "Call out breaking changes, migration steps, and feature flags explicitly." }
  ],

  // ── Telemetry / observability (optional) ──
  // Set otel.enabled=true and an exporter to ship Copilot Chat traces. Default off — switch on
  // only if you have an OTLP collector running locally / in your network.
  "github.copilot.chat.otel.enabled": false,
  // "github.copilot.chat.otel.exporterType": "otlp",
  // "github.copilot.chat.otel.otlpEndpoint": "http://localhost:4318",
  // "github.copilot.chat.otel.captureContent": false,

  // ── Editor ──
  "editor.inlineSuggest.enabled": true,
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "editor.rulers": [120],
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.stickyScroll.enabled": true,
  "editor.minimap.enabled": false,

  // ── Terminal ──
  "terminal.integrated.fontSize": 13,

  // ── Files ──
  "files.autoSave": "onFocusChange",
  "files.exclude": {
    "**/bin": true,
    "**/obj": true,
    "**/node_modules": true,
    "**/.git": true
  },
  "search.exclude": {
    "**/bin": true,
    "**/obj": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/coverage": true
  },

  // ── Git ──
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,

  // ── C# / .NET ──
  "dotnet.defaultSolution": "disable",
  "omnisharp.enableEditorConfigSupport": true,

  // ── TypeScript ──
  "typescript.preferences.importModuleSpecifier": "relative",
  "typescript.suggest.autoImports": true,
  "typescript.updateImportsOnFileMove.enabled": "always",

  // ── Explorer ──
  "explorer.confirmDelete": false,
  "explorer.compactFolders": false
}
