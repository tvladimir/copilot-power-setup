[
  // ── Copilot Chat ──
  { "key": "ctrl+shift+i", "command": "workbench.action.chat.open" },
  { "key": "ctrl+shift+a", "command": "github.copilot.chat.attachContext" },

  // ── Quick Actions ──
  { "key": "ctrl+shift+t", "command": "workbench.action.tasks.runTask" },
  { "key": "alt+shift+f", "command": "editor.action.formatDocument" },

  // ── Navigation ──
  { "key": "ctrl+shift+e", "command": "workbench.action.showAllEditors" },
  { "key": "alt+left",     "command": "workbench.action.navigateBack" },
  { "key": "alt+right",    "command": "workbench.action.navigateForward" },

  // ── Terminal ──
  { "key": "ctrl+`",       "command": "workbench.action.terminal.toggleTerminal" }
]
