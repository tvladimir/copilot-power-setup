{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": ["build"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "command": "dotnet",
      "type": "process",
      "args": ["test", "--verbosity", "normal"],
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test:watch",
      "command": "dotnet",
      "type": "process",
      "args": ["watch", "test"],
      "group": "test",
      "isBackground": true
    },
    {
      "label": "ef:migration:add",
      "command": "dotnet",
      "type": "process",
      "args": ["ef", "migrations", "add", "${input:migrationName}"],
      "problemMatcher": []
    },
    {
      "label": "ef:database:update",
      "command": "dotnet",
      "type": "process",
      "args": ["ef", "database", "update"],
      "problemMatcher": []
    },
    {
      "label": "run",
      "command": "dotnet",
      "type": "process",
      "args": ["run"],
      "group": "none",
      "problemMatcher": "$msCompile"
    }
  ],
  "inputs": [
    {
      "id": "migrationName",
      "description": "Migration name (PascalCase)",
      "type": "promptString"
    }
  ]
}
